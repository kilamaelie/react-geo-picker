{
  "name": "@kilamaelie/react-geo-picker",
  "version": "1.0.1",
  "description": "Lightweight, responsive React modal components and utilities for selecting countries, cities, and country codes.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/index.css --minify",
    "build:js": "tsup src/index.ts --format cjs,esm --dts",
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kilamaelie/react-geo-picker.git"
  },
  "keywords": [
    "react",
    "typescript",
    "tailwind",
    "countries",
    "cities",
    "phone-code",
    "modal",
    "nextjs",
    "vite"
  ],
  "author": "Kilama Elie",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kilamaelie/react-geo-picker/issues"
  },
  "homepage": "https://github.com/kilamaelie/react-geo-picker#readme",
  "peerDependencies": {
    "lucide-react": "^1.41.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.5.5",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "react-hook-form": "^7.87.0",
    "tailwind-merge": "^3.6.0"
  }
}
